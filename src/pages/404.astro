---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import { servicios } from '../data/servicios.js';
---

<Base
  titulo="Página no encontrada"
  descripcion="La página que buscás no existe. Volvé al inicio o mirá nuestros servicios de fletes y mudanzas en Santiago."
  noindex={true}
>
  <section class="seccion error">
    <div class="contenedor-angosto">
      <span class="codigo" aria-hidden="true">404</span>
      <h1>Esta página no existe</h1>
      <p class="texto">
        Puede que el enlace esté mal escrito o que la página haya cambiado de
        dirección. Estos son los caminos más útiles:
      </p>

      <div class="grupo-botones centrado">
        <a href="/" class="boton boton-primario">Ir al inicio</a>
        <a href="/cotizar" class="boton boton-secundario">Cotizar un flete</a>
      </div>

      <ul class="atajos">
        {
          servicios.map((s) => (
            <li>
              <a href={`/servicios/${s.slug}`}>
                <Icono nombre={s.icono} />
                {s.tituloCorto}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .error {
    text-align: center;
    padding-block: clamp(3rem, 2rem + 6vw, 7rem);
  }

  .codigo {
    display: block;
    font-size: clamp(4rem, 3rem + 8vw, 8rem);
    font-weight: var(--peso-black);
    line-height: 1;
    color: var(--azul-100);
    letter-spacing: -0.04em;
  }

  .error h1 {
    color: var(--azul-900);
    margin-block: var(--e-4) var(--e-4);
  }

  .texto {
    font-size: var(--txt-lg);
    color: var(--texto-suave);
    max-width: 48ch;
    margin-inline: auto;
    margin-bottom: var(--e-8);
  }

  .grupo-botones.centrado {
    justify-content: center;
  }

  .atajos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--e-3);
    list-style: none;
    padding: 0;
    margin-top: var(--e-10);
  }

  .atajos a {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    min-height: 44px;
    padding: var(--e-2) var(--e-5);
    background: var(--fondo-alt);
    border: 1px solid var(--borde);
    border-radius: var(--radio-full);
    font-size: var(--txt-sm);
    font-weight: var(--peso-semi);
    color: var(--azul-800);
    text-decoration: none;
  }

  .atajos a:hover {
    border-color: var(--azul-500);
    background: var(--azul-50);
  }

  .atajos :global(.icono) {
    width: 18px;
    height: 18px;
    color: var(--azul-600);
  }
</style>
