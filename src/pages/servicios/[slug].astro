---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Migas from '../../components/Migas.astro';
import Icono from '../../components/Icono.astro';
import FormularioCotizacion from '../../components/FormularioCotizacion.astro';
import ListaFaq from '../../components/ListaFaq.astro';
import CtaFinal from '../../components/CtaFinal.astro';

import { servicios } from '../../data/servicios.js';
import { comunas } from '../../data/comunas.js';
import { faq } from '../../data/faq.js';
import { foto } from '../../lib/imagenes.js';
import { migasSchema, servicioSchema, negocioLocal, faqSchema } from '../../lib/jsonld.js';

export function getStaticPaths() {
  return servicios.map((servicio) => ({
    params: { slug: servicio.slug },
    props: { servicio },
  }));
}

const { servicio } = Astro.props;
const imagen = foto(servicio.foto);

// El resto de los servicios, para enlazado interno.
const otros = servicios.filter((s) => s.slug !== servicio.slug);

const faqDelServicio = faq.slice(0, 4);

const migas = [
  { texto: 'Inicio', href: '/' },
  { texto: 'Servicios', href: '/servicios' },
  { texto: servicio.tituloCorto, href: `/servicios/${servicio.slug}` },
];

// Los tipos del formulario usan textos propios; se mapean por slug.
const tipoFormulario: Record<string, string> = {
  mudanzas: 'Mudanza de casa o departamento',
  'transporte-de-carga': 'Transporte de carga',
  'retiro-de-materiales': 'Retiro de materiales o escombros',
  embalaje: 'Embalaje',
};
---

<Base
  titulo={servicio.metaTitulo}
  descripcion={servicio.metaDescripcion}
  jsonLd={[
    migasSchema(migas),
    servicioSchema(servicio),
    negocioLocal(),
    faqSchema(faqDelServicio),
  ]}
>
  <Migas items={migas} />

  <!-- Cabecera del servicio -->
  <section class="cabecera-servicio">
    <div class="contenedor cabecera-grilla">
      <div>
        <span class="antetitulo">Servicio</span>
        <h1>{servicio.titulo}</h1>
        <p class="entradilla">{servicio.intro}</p>

        <div class="grupo-botones">
          <a href="#cotizar" class="boton boton-primario">Cotizar este servicio</a>
          <a href="/servicios" class="boton boton-secundario">Ver otros servicios</a>
        </div>
      </div>

      <figure class="cabecera-figura">
        <Image
          src={imagen}
          alt={servicio.fotoAlt}
          widths={[520, 760, 1000]}
          sizes="(min-width: 1024px) 500px, 92vw"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <!-- Qué incluye / para qué sirve -->
  <section class="seccion seccion-alt">
    <div class="contenedor grilla grilla-2 bloques">
      <div class="bloque">
        <h2>Qué incluye</h2>
        <ul class="lista-check">
          {
            servicio.incluye.map((item) => (
              <li>
                <Icono nombre="check" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="bloque">
        <h2>Ideal para</h2>
        <ul class="lista-check">
          {
            servicio.ideal.map((item) => (
              <li>
                <Icono nombre="check" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Cobertura -->
  <section class="seccion">
    <div class="contenedor-angosto">
      <h2>Dónde damos este servicio</h2>
      <p class="texto-suave">
        Cubrimos toda la Región Metropolitana. Estas son las comunas con página
        propia, donde detallamos los accesos y particularidades de cada zona.
      </p>
      <ul class="chips-comunas">
        {
          comunas.map((c) => (
            <li>
              <a href={`/fletes-en/${c.slug}`}>{c.nombre}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Formulario precargado con este servicio -->
  <FormularioCotizacion
    servicioPorDefecto={tipoFormulario[servicio.slug] ?? ''}
    titulo={`Cotizá tu ${servicio.tituloCorto.toLowerCase()}`}
  />

  <!-- FAQ -->
  <section class="seccion">
    <div class="contenedor-angosto">
      <ListaFaq preguntas={faqDelServicio} titulo="Preguntas frecuentes" />
      <p class="ver-mas">
        <a href="/preguntas-frecuentes">Ver todas las preguntas</a>
      </p>
    </div>
  </section>

  <!-- Otros servicios -->
  <section class="seccion seccion-alt">
    <div class="contenedor">
      <h2 class="titulo-otros">Otros servicios</h2>
      <ul class="lista-otros">
        {
          otros.map((o) => (
            <li>
              <a href={`/servicios/${o.slug}`}>
                <span class="otro-icono" aria-hidden="true">
                  <Icono nombre={o.icono} />
                </span>
                <span>
                  <strong>{o.tituloCorto}</strong>
                  <small>{o.resumen}</small>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaFinal mensaje={`Hola, quisiera cotizar el servicio de ${servicio.tituloCorto.toLowerCase()}.`} />
</Base>

<style>
  .cabecera-servicio {
    padding-block: clamp(2rem, 1.5rem + 3vw, 4rem);
    background: linear-gradient(180deg, var(--azul-50), var(--blanco));
  }

  .cabecera-grilla {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 1.5rem + 3vw, 3.5rem);
    align-items: center;
  }

  .cabecera-grilla h1 {
    color: var(--azul-900);
    margin-bottom: var(--e-5);
  }

  .entradilla {
    font-size: var(--txt-lg);
    line-height: 1.7;
    color: var(--texto-suave);
    max-width: 56ch;
    margin-bottom: var(--e-8);
  }

  .cabecera-figura {
    margin: 0;
  }

  .cabecera-figura :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radio-xl);
    box-shadow: var(--sombra-lg);
  }

  /* --- Bloques incluye / ideal --- */
  .bloques .bloque {
    padding: var(--e-6);
    background: var(--blanco);
    border: 1px solid var(--borde);
    border-radius: var(--radio-lg);
  }

  .bloque h2 {
    font-size: var(--txt-h3);
    color: var(--azul-900);
    margin-bottom: var(--e-5);
  }

  .lista-check {
    display: flex;
    flex-direction: column;
    gap: var(--e-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .lista-check li {
    display: flex;
    align-items: flex-start;
    gap: var(--e-3);
    line-height: 1.6;
  }

  .lista-check :global(.icono) {
    width: 20px;
    height: 20px;
    margin-top: 3px;
    flex-shrink: 0;
    color: var(--verde-wa-oscuro);
    stroke-width: 2.6;
  }

  /* --- Cobertura --- */
  .texto-suave {
    color: var(--texto-suave);
    margin-block: var(--e-4) var(--e-6);
  }

  .chips-comunas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .chips-comunas a {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: var(--e-2) var(--e-4);
    background: var(--azul-50);
    border: 1px solid var(--azul-100);
    border-radius: var(--radio-full);
    font-size: var(--txt-sm);
    font-weight: var(--peso-semi);
    color: var(--azul-700);
    text-decoration: none;
    transition: background-color var(--transicion);
  }

  .chips-comunas a:hover {
    background: var(--azul-100);
  }

  .ver-mas {
    margin-top: var(--e-6);
    text-align: center;
    font-size: var(--txt-sm);
    font-weight: var(--peso-semi);
  }

  /* --- Otros servicios --- */
  .titulo-otros {
    margin-bottom: var(--e-8);
  }

  .lista-otros {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--e-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .lista-otros a {
    display: flex;
    align-items: flex-start;
    gap: var(--e-4);
    height: 100%;
    padding: var(--e-5);
    background: var(--blanco);
    border: 1px solid var(--borde);
    border-radius: var(--radio-lg);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--transicion), transform var(--transicion),
      box-shadow var(--transicion);
  }

  .lista-otros a:hover {
    border-color: var(--azul-500);
    transform: translateY(-2px);
    box-shadow: var(--sombra);
  }

  .otro-icono {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    border-radius: var(--radio);
    background: var(--azul-50);
    color: var(--azul-600);
  }

  .lista-otros strong {
    display: block;
    font-size: var(--txt-base);
    color: var(--azul-900);
    margin-bottom: 2px;
  }

  .lista-otros small {
    display: block;
    font-size: var(--txt-sm);
    line-height: 1.55;
    color: var(--texto-suave);
  }

  @media (min-width: 768px) {
    .lista-otros {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .cabecera-grilla {
      grid-template-columns: 1fr minmax(400px, 500px);
      gap: var(--e-16);
    }
  }
</style>
