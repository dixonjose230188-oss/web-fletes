---
/**
 * Barra de acción fija en móvil.
 *
 * El sitio anterior no tenía ningún CTA persistente: el visitante que
 * llegaba de un anuncio tenía que scrollear hasta el formulario para
 * poder contactar. Con tráfico pago mayoritariamente móvil, esto es
 * de lo que más mueve la tasa de conversión.
 */
import { negocio, whatsappUrl } from '../data/negocio.js';
---

<div class="barra-accion" role="region" aria-label="Contacto rápido">
  <a
    href={`tel:${negocio.telefonoE164}`}
    class="accion accion-llamar"
    data-origen="barra-movil"
  >
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path
        d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.6a1 1 0 0 1-.25 1l-2.22 2.2Z"
        fill="currentColor"></path>
    </svg>
    <span>Llamar</span>
  </a>

  <a
    href={whatsappUrl('Hola, quisiera cotizar un flete.')}
    class="accion accion-wa"
    target="_blank"
    rel="noopener"
    data-origen="barra-movil"
  >
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path
        d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm5.8 14.16c-.25.69-1.43 1.32-1.99 1.4-.53.08-1.2.11-1.94-.12-.45-.14-1.02-.33-1.76-.65-3.1-1.34-5.12-4.46-5.28-4.67-.15-.21-1.26-1.67-1.26-3.19s.8-2.27 1.08-2.58c.28-.31.62-.39.82-.39l.59.01c.19.01.44-.7.69.53.25.61.87 2.12.94 2.27.08.15.13.33.02.53-.1.21-.16.33-.31.51-.15.18-.32.4-.46.54-.15.15-.31.32-.13.62.18.31.79 1.31 1.7 2.12 1.17 1.04 2.16 1.37 2.47 1.52.31.15.49.13.67-.08.18-.21.77-.9.98-1.21.2-.31.41-.26.69-.15.28.1 1.79.84 2.09.99.31.15.51.23.59.36.07.13.07.75-.18 1.44Z"
        fill="currentColor"></path>
    </svg>
    <span>Cotizar por WhatsApp</span>
  </a>
</div>

<style>
  .barra-accion {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 90;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--e-2);
    padding: var(--e-2) var(--e-3);
    padding-bottom: calc(var(--e-2) + env(safe-area-inset-bottom));
    background: rgb(255 255 255 / 0.95);
    backdrop-filter: blur(12px);
    border-top: 1px solid var(--borde);
    box-shadow: 0 -4px 20px rgb(15 23 42 / 0.08);
  }

  .accion {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--e-2);
    min-height: 50px;
    padding-inline: var(--e-4);
    border-radius: var(--radio-full);
    font-weight: var(--peso-bold);
    font-size: var(--txt-base);
    text-decoration: none;
    line-height: 1.2;
  }

  .accion svg {
    width: 21px;
    height: 21px;
    flex-shrink: 0;
  }

  .accion-llamar {
    background: var(--azul-100);
    color: var(--azul-800);
    padding-inline: var(--e-5);
  }

  .accion-wa {
    background: var(--verde-wa);
    color: #04301a;
  }

  .accion-wa:active {
    background: var(--verde-wa-oscuro);
  }

  /* A partir de 1024px el header ya muestra teléfono y botón Cotizar */
  @media (min-width: 1024px) {
    .barra-accion {
      display: none;
    }
  }
</style>

<style is:global>
  /* Reserva el espacio que ocupa la barra para que no tape el pie */
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(66px + env(safe-area-inset-bottom));
    }
  }
</style>
