---
/**
 * Migas de pan. Ayudan al usuario a orientarse y le dan a Google la
 * jerarquía del sitio (se refuerza con BreadcrumbList en el JSON-LD).
 */
interface Props {
  items: { texto: string; href: string }[];
}

const { items } = Astro.props;
const ultimo = items.length - 1;
---

<nav class="migas" aria-label="Ruta de navegación">
  <div class="contenedor">
    <ol>
      {
        items.map((item, i) => (
          <li>
            {i === ultimo ? (
              <span aria-current="page">{item.texto}</span>
            ) : (
              <>
                <a href={item.href}>{item.texto}</a>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path
                    d="m9 6 6 6-6 6"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    fill="none"
                  />
                </svg>
              </>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</nav>

<style>
  .migas {
    border-bottom: 1px solid var(--borde);
    background: var(--fondo-alt);
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-1);
    list-style: none;
    padding: var(--e-3) 0;
    margin: 0;
    font-size: var(--txt-sm);
  }

  li {
    display: inline-flex;
    align-items: center;
    gap: var(--e-1);
  }

  a {
    color: var(--texto-tenue);
    text-decoration: none;
  }

  a:hover {
    color: var(--azul-600);
    text-decoration: underline;
  }

  span[aria-current] {
    color: var(--texto);
    font-weight: var(--peso-semi);
  }

  svg {
    width: 15px;
    height: 15px;
    color: var(--gris-300);
    flex-shrink: 0;
  }
</style>
