---
import { Image } from 'astro:assets';
import Icono from './Icono.astro';
import { foto } from '../lib/imagenes.js';

interface Props {
  servicio: {
    slug: string;
    titulo: string;
    tituloCorto: string;
    resumen: string;
    icono: string;
    foto: string;
    fotoAlt: string;
  };
  /** La primera tarjeta visible no debe ir en lazy. */
  prioridad?: boolean;
}

const { servicio, prioridad = false } = Astro.props;
const imagen = foto(servicio.foto);
---

<article class="tarjeta tarjeta-servicio">
  <a href={`/servicios/${servicio.slug}`} class="tarjeta-enlace">
    <div class="tarjeta-imagen">
      <Image
        src={imagen}
        alt={servicio.fotoAlt}
        widths={[400, 640, 800]}
        sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 92vw"
        loading={prioridad ? 'eager' : 'lazy'}
        decoding={prioridad ? 'sync' : 'async'}
      />
      <span class="tarjeta-icono" aria-hidden="true">
        <Icono nombre={servicio.icono} />
      </span>
    </div>

    <div class="tarjeta-cuerpo">
      <h3>{servicio.tituloCorto}</h3>
      <p>{servicio.resumen}</p>
      <span class="tarjeta-mas">
        Ver detalle
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            d="M5 12h14m-6-6 6 6-6 6"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            fill="none"></path>
        </svg>
      </span>
    </div>
  </a>
</article>

<style>
  .tarjeta-servicio {
    display: flex;
  }

  .tarjeta-enlace {
    display: flex;
    flex-direction: column;
    width: 100%;
    text-decoration: none;
    color: inherit;
  }

  .tarjeta-imagen {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--gris-100);
  }

  .tarjeta-imagen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .tarjeta-servicio:hover .tarjeta-imagen :global(img) {
    transform: scale(1.04);
  }

  .tarjeta-icono {
    position: absolute;
    left: var(--e-4);
    bottom: var(--e-4);
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: var(--radio);
    background: var(--blanco);
    color: var(--azul-600);
    box-shadow: var(--sombra);
  }

  .tarjeta-cuerpo {
    display: flex;
    flex-direction: column;
    gap: var(--e-2);
    padding: var(--e-5);
    flex: 1;
  }

  .tarjeta-cuerpo h3 {
    font-size: var(--txt-h4);
    color: var(--azul-900);
  }

  .tarjeta-cuerpo p {
    font-size: var(--txt-sm);
    line-height: 1.65;
    color: var(--texto-suave);
    flex: 1;
  }

  .tarjeta-mas {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    margin-top: var(--e-2);
    font-size: var(--txt-sm);
    font-weight: var(--peso-bold);
    color: var(--azul-600);
  }

  .tarjeta-mas svg {
    width: 17px;
    height: 17px;
    transition: transform var(--transicion);
  }

  .tarjeta-servicio:hover .tarjeta-mas svg {
    transform: translateX(3px);
  }
</style>
