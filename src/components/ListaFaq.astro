---
interface Props {
  preguntas: { pregunta: string; respuesta: string }[];
  titulo?: string;
}

const { preguntas, titulo } = Astro.props;
---

<div class="faq">
  {titulo && <h2 class="faq-titulo">{titulo}</h2>}

  <div class="faq-lista">
    {
      preguntas.map((p) => (
        <details class="faq-item">
          <summary>
            <span>{p.pregunta}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                d="M12 5v14M5 12h14"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                fill="none"
              />
            </svg>
          </summary>
          <div class="faq-respuesta">
            <p>{p.respuesta}</p>
          </div>
        </details>
      ))
    }
  </div>
</div>

<style>
  .faq-titulo {
    margin-bottom: var(--e-8);
  }

  .faq-lista {
    display: flex;
    flex-direction: column;
    gap: var(--e-3);
  }

  .faq-item {
    background: var(--blanco);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    overflow: hidden;
    transition: border-color var(--transicion), box-shadow var(--transicion);
  }

  .faq-item[open] {
    border-color: var(--azul-100);
    box-shadow: var(--sombra-sm);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-4);
    padding: var(--e-4) var(--e-5);
    min-height: 56px;
    font-size: var(--txt-base);
    font-weight: var(--peso-semi);
    color: var(--azul-900);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    background: var(--azul-50);
  }

  summary svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--azul-600);
    transition: transform var(--transicion);
  }

  .faq-item[open] summary svg {
    transform: rotate(45deg);
  }

  .faq-respuesta {
    padding: 0 var(--e-5) var(--e-5);
  }

  .faq-respuesta p {
    color: var(--texto-suave);
    line-height: 1.7;
    max-width: 68ch;
  }
</style>
